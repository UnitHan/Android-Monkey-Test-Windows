{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monkey 테스트 자동화",
  "version": "4.0.0",
  "identifier": "com.monkeytest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monkey 테스트 자동화",
        "width": 1200,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
